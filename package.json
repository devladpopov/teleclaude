    "@grammyjs/runner": "^2.0.3",
    "chrono-node": "^2.7.7",
    "grammy": "^1.41.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.2"
  }
}
