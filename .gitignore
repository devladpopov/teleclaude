*.tmp
/*.txt
/*.cmd
.do-*
.git-commit-msg-*
.commit-msg-*
runner/*.txt
runner/do-*.ps1

# build output
dist/
.bun-build/
.bun-build-check/
.build-check/
.tmp/
.tmp-build/
nul/

# local-only templates and assets
templates/openclaw-memory/
templates/SOUL.md
templates/main-memory.md
assets/

