# --- required ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- webhook mode (optional; long polling is used when unset) ---
# ROUTER_WEBHOOK_URL=https://teleclaude.example.com/telegram
# ROUTER_WEBHOOK_SECRET=random_long_string
# ROUTER_HEALTH_PORT=7885
# ROUTER_BIND_HOST=127.0.0.1
# Optional shared secret for /internal/trigger (set the same value for mcp-router)
# ROUTER_INTERNAL_SECRET=

# --- runner sidecar ---
# CLAUDE_RUNNER_PORT=7878
# CLAUDE_RUNNER_MAX_CONCURRENT=5
# CLAUDE_RUNNER_HOST=127.0.0.1

# --- Director ---
# Chats where Director may auto-trigger stale topics (comma-separated). Empty = no restriction.
# DIRECTOR_ALLOWED_CHATS=-1001234567890
# Topic for the morning summary, "chatId:threadId".
# DIRECTOR_SUMMARY_TOPIC=-1001234567890:42

# Optional upload of the Director dashboard JSON to a static host over SSH.
# Sync is disabled while DASHBOARD_SYNC_REMOTE is unset.
# DASHBOARD_SYNC_REMOTE=user@host.example.com
# DASHBOARD_SYNC_SSH_KEY=/c/Users/me/.ssh/id_ed25519
# DASHBOARD_SYNC_DIR=~/public_html/hub/
# DASHBOARD_SYNC_DISABLED=1
# GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# --- realtime extractor (optional, off by default; sends message text to Gemini) ---
# GEMINI_API_KEY=

# --- paths ---
# Shared long-term memory (default ~/.teleclaude/memory)
# TELECLAUDE_MEMORY_DIR=
# Static MCP config for spawned claude (default ~/.claude/spawn-mcp-config.json)
# TELECLAUDE_MCP_CONFIG=

# --- browser pool broker ---
# BROWSER_POOL_PROFILE_ROOT=
# BROWSER_POOL_LOG_DIR=
# BROWSER_POOL_DEDICATED=config/browser-dedicated.json
